APP_NAME=secure-api
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
LOG_LEVEL=info
ALLOW_ORIGINS=http://localhost:3001
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
REQUEST_MAX_BODY_BYTES=1048576
JWT_SECRET=change-me-please
JWT_TTL=15m
AUTH_DEMO_USERNAME=admin
AUTH_DEMO_PASSWORD=password123

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=workmanagement
DB_USERNAME=root
DB_PASSWORD=yourpassword
DB_MAX_OPEN=25
DB_MAX_IDLE=5
